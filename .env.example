# =============================================================================
# Environment variables — copy to .env and fill in
# NEVER commit .env to git
# =============================================================================

# --- Database ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_TO_LONG_RANDOM_STRING

# --- Odoo master password (DB management) ---
ODOO_ADMIN_PASSWORD=CHANGE_ME_TO_LONG_RANDOM_STRING

# --- GCP / Backups ---
GCP_PROJECT_ID=tshirt-odoo-prod
GCS_BACKUP_BUCKET=tshirt-odoo-backups

# --- Domain (use nip.io if no real domain) ---
# Format: <vm-external-ip>.nip.io  →  e.g.  34.123.45.67.nip.io
PROD_HOSTNAME=
STAGING_HOSTNAME=
DEV_HOSTNAME=

# --- Production SMTP (Brevo / Mailgun / Sendgrid) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
