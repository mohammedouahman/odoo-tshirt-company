<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_proof_ready" model="mail.template">
            <field name="name">T-Shirt: Proof Ready for Approval</field>
            <field name="model_id" ref="model_tshirt_production_order"/>
            <field name="subject">Your T-shirt design proof is ready — {{ object.reference }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.partner_id.name or 'there'"/>,</p>
                    <p>Your design proof for order <strong t-out="object.reference"/>
                       is ready for your review.</p>
                    <p>Please reply to this email to confirm or request changes.</p>
                    <p>Thanks,<br/>The T-Shirt Branding Team</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
